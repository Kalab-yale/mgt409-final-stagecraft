# Copy to .env and fill in ONE of these. Never commit .env.
# Preferred: Portkey gateway key (used with the course model gpt-6-luna).
PORTKEY_API_KEY=
# Fallback: direct OpenAI key, used only if PORTKEY_API_KEY is empty.
OPENAI_API_KEY=
# Optional: override the model name (default gpt-6-luna).
# STAGECRAFT_MODEL=gpt-6-luna
